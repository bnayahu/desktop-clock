#include <windows.h>
#include "resource.h"
#include "app_strings.h"

// Icons
IDI_CLOCK_ICON ICON "clock_icon.ico"
IDI_TRAY_ICON  ICON "tray_icon.ico"

// Settings Dialog
IDD_SETTINGS DIALOGEX 0, 0, 300, 340
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Desktop Clock Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Time Format", -1, 7, 7, 286, 40
    AUTORADIOBUTTON "12-hour", IDC_RADIO_12H, 15, 22, 60, 10, WS_GROUP
    AUTORADIOBUTTON "24-hour", IDC_RADIO_24H, 85, 22, 60, 10
    
    GROUPBOX        "Display Options", -1, 7, 52, 286, 30
    AUTOCHECKBOX    "Show seconds", IDC_CHECK_SECONDS, 15, 67, 100, 10
    
    GROUPBOX        "Window Options", -1, 7, 87, 286, 30
    AUTOCHECKBOX    "Always on top", IDC_CHECK_TOPMOST, 15, 102, 100, 10
    
    GROUPBOX        "Appearance", -1, 7, 122, 286, 110
    LTEXT           "Text Color:", -1, 15, 137, 50, 10
    PUSHBUTTON      "Choose Color...", IDC_BUTTON_COLOR, 70, 135, 80, 14
    CONTROL         "", IDC_STATIC_COLOR_BOX, "Static", SS_BLACKFRAME, 155, 135, 30, 14
    
    LTEXT           "Transparency:", -1, 15, 162, 50, 10
    CONTROL         "", IDC_SLIDER_ALPHA, "msctls_trackbar32", 
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 70, 160, 150, 20
    LTEXT           "255", IDC_STATIC_ALPHA_VALUE, 225, 162, 30, 10
    
    LTEXT           "Font Size:", -1, 15, 192, 50, 10
    COMBOBOX        IDC_COMBO_FONTSIZE, 70, 190, 80, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "(Drag window edges to resize)", -1, 15, 212, 200, 10
    
    GROUPBOX        "Startup", -1, 7, 237, 286, 30
    AUTOCHECKBOX    "Start Desktop Clock when Windows starts",
                    IDC_CHECK_STARTUP, 15, 252, 200, 10
    
    GROUPBOX        "Preview", -1, 7, 272, 286, 40
    LTEXT           "14:35", IDC_STATIC_PREVIEW, 15, 287, 270, 20,
                    SS_CENTER
    
    DEFPUSHBUTTON   "OK", IDOK, 70, 320, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 130, 320, 50, 14
    PUSHBUTTON      "Apply", IDAPPLY, 190, 320, 50, 14
END

// About Dialog
IDD_ABOUT DIALOGEX 0, 0, 260, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Desktop Clock"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_CLOCK_ICON, -1, 14, 14, 21, 20
    LTEXT           "Desktop Clock v1.0", -1, 50, 14, 200, 10
    LTEXT           "", -1, 50, 28, 200, 1, SS_ETCHEDHORZ
    LTEXT           "A floating digital clock widget for Windows.", -1, 50, 35, 200, 10
    LTEXT           "", -1, 14, 50, 232, 1, SS_ETCHEDHORZ
    LTEXT           "Features:", -1, 14, 56, 232, 10
    LTEXT           "• Configurable time format (12/24 hour)", -1, 20, 68, 226, 10
    LTEXT           "• Optional seconds display", -1, 20, 80, 226, 10
    LTEXT           "• Customizable color and transparency", -1, 20, 92, 226, 10
    LTEXT           "• Resizable window with auto-scaling font", -1, 20, 104, 226, 10
    DEFPUSHBUTTON   "OK", IDOK, 105, 120, 50, 14
END