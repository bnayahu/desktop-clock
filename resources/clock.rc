// This file is UTF-8 (e.g. the bullets in the About dialog).
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "app_strings.h"

// Icons
IDI_CLOCK_ICON ICON "clock_icon.ico"
IDI_TRAY_ICON  ICON "tray_icon.ico"

// Version information (shown in the executable's Windows file properties)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR,APP_VERSION_MINOR,0,0
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"    // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "Jonathan Bnayahu"
            VALUE "FileDescription",  "Desktop Clock"
            VALUE "FileVersion",      APP_VERSION_STR_FULL
            VALUE "InternalName",     "DesktopClock"
            VALUE "LegalCopyright",   APP_COPYRIGHT
            VALUE "OriginalFilename", "DesktopClock.exe"
            VALUE "ProductName",      "Desktop Clock"
            VALUE "ProductVersion",   APP_VERSION_STR_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END

// Settings Dialog
IDD_SETTINGS DIALOGEX 0, 0, 300, 380
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Desktop Clock Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "General", -1, 7, 7, 286, 45
    AUTORADIOBUTTON "12-hour", IDC_RADIO_12H, 15, 20, 60, 10, WS_GROUP
    AUTORADIOBUTTON "24-hour", IDC_RADIO_24H, 85, 20, 60, 10
    AUTOCHECKBOX    "Show seconds", IDC_CHECK_SECONDS, 15, 35, 65, 10, WS_GROUP
    AUTOCHECKBOX    "Always on top", IDC_CHECK_TOPMOST, 85, 35, 65, 10
    AUTOCHECKBOX    "Start with Windows", IDC_CHECK_STARTUP, 160, 35, 90, 10
    
    GROUPBOX        "Appearance", -1, 7, 57, 286, 160
    LTEXT           "Text Color:", -1, 15, 72, 50, 10
    PUSHBUTTON      "Choose Color...", IDC_BUTTON_COLOR, 70, 70, 80, 14
    CONTROL         "", IDC_STATIC_COLOR_BOX, "Static", SS_BLACKFRAME, 155, 70, 30, 14
    
    LTEXT           "Background Opacity:", -1, 15, 97, 70, 10
    CONTROL         "", IDC_SLIDER_ALPHA, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 90, 95, 130, 20
    LTEXT           "255", IDC_STATIC_ALPHA_VALUE, 225, 97, 30, 10
    
    LTEXT           "Text Opacity:", -1, 15, 122, 70, 10
    CONTROL         "", IDC_SLIDER_TEXT_ALPHA, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 90, 120, 130, 20
    LTEXT           "255", IDC_STATIC_TEXT_ALPHA_VALUE, 225, 122, 30, 10
    
    LTEXT           "Font:", -1, 15, 152, 50, 10
    COMBOBOX        IDC_COMBO_FONTNAME, 70, 150, 120, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "Font Size:", -1, 15, 177, 50, 10
    COMBOBOX        IDC_COMBO_FONTSIZE, 70, 175, 80, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "(Drag window edges to resize)", -1, 15, 197, 200, 10
    
    GROUPBOX        "World Clock", -1, 7, 222, 286, 75
    LTEXT           "Zone 1:", -1, 15, 239, 30, 10
    COMBOBOX        IDC_COMBO_TZ1, 48, 237, 150, 150,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Label:", -1, 205, 239, 25, 10
    EDITTEXT        IDC_EDIT_LABEL1, 232, 237, 55, 12, ES_AUTOHSCROLL
    LTEXT           "Zone 2:", -1, 15, 258, 30, 10
    COMBOBOX        IDC_COMBO_TZ2, 48, 256, 150, 150,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Label:", -1, 205, 258, 25, 10
    EDITTEXT        IDC_EDIT_LABEL2, 232, 256, 55, 12, ES_AUTOHSCROLL
    LTEXT           "Main time size:", -1, 15, 279, 70, 10
    CONTROL         "", IDC_SLIDER_SPLIT, "msctls_trackbar32",
                    TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 90, 275, 130, 20
    LTEXT           "70%", IDC_STATIC_SPLIT_VALUE, 225, 279, 30, 10
    
    GROUPBOX        "Preview", -1, 7, 302, 286, 50
    LTEXT           "14:35", IDC_STATIC_PREVIEW, 15, 317, 270, 30,
                    SS_CENTER
    
    DEFPUSHBUTTON   "OK", IDOK, 70, 360, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 130, 360, 50, 14
    PUSHBUTTON      "Apply", IDAPPLY, 190, 360, 50, 14
END

// About Dialog
IDD_ABOUT DIALOGEX 0, 0, 260, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Desktop Clock"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_CLOCK_ICON, -1, 14, 14, 21, 20
    LTEXT           "Desktop Clock", IDC_STATIC_ABOUT_VERSION, 50, 14, 200, 10
    LTEXT           "", -1, 50, 28, 200, 1, SS_ETCHEDHORZ
    LTEXT           "A floating digital clock widget for Windows.", -1, 50, 35, 200, 10
    LTEXT           "", -1, 14, 50, 232, 1, SS_ETCHEDHORZ
    LTEXT           "Features:", -1, 14, 56, 232, 10
    LTEXT           "• Configurable time format (12/24 hour)", -1, 20, 68, 226, 10
    LTEXT           "• Optional seconds display", -1, 20, 80, 226, 10
    LTEXT           "• Customizable color and transparency", -1, 20, 92, 226, 10
    LTEXT           "• Resizable window with auto-scaling font", -1, 20, 104, 226, 10
    DEFPUSHBUTTON   "OK", IDOK, 105, 120, 50, 14
END